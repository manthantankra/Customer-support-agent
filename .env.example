# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_DB=support_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Connection string for local machine development:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/support_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/support_db
# Connection string for Docker Compose internal network (used in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/support_db

